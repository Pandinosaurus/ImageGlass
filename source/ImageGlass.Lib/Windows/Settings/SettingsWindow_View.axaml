<ui:PhControl
    x:Class="ImageGlass.Common.Windows.SettingsWindowView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    xmlns:types="using:ImageGlass.Common.Types"
    xmlns:ui="using:ImageGlass.UI"
    xmlns:windows="using:ImageGlass.Common.Windows"
    mc:Ignorable="d"
    d:DesignHeight="560"
    d:DesignWidth="900"
    x:Name="Root"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <!--  Shared values reused across all settings pages  -->
    <ui:PhControl.Resources>
        <!--  Left indentation of the content under a group/sub-group heading  -->
        <Thickness x:Key="SettingsGroupIndent">20,0,0,0</Thickness>
        <!--  Vertical gap between a setting's label and its input control  -->
        <x:Double x:Key="SettingsLabelInputGap">5</x:Double>
    </ui:PhControl.Resources>


    <!--  Shared styles for all settings pages (cascade to the hosted page content)  -->
    <ui:PhControl.Styles>
        <!--  Setting group heading: semibold, subtitle size  -->
        <Style Selector="TextBlock.group">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{x:Static types:Const.FONT_SIZE_SUBTITLE}" />
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>

        <!--  First group heading on a page: no top margin (the page already has top padding)  -->
        <Style Selector="TextBlock.group:nth-child(1)">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!--  Setting sub-group heading: semibold, body size  -->
        <Style Selector="TextBlock.subgroup">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
    </ui:PhControl.Styles>


    <!--  sidebar | content  -->
    <Grid ColumnDefinitions="Auto, *">

        <!--  Sidebar  -->
        <ListBox
            x:Name="PART_Sidebar"
            Grid.Column="0"
            MinWidth="200"
            Padding="14"
            Background="Transparent">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
                    <Setter Property="Padding" Value="10,6" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Margin" Value="0,1" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="windows:SettingsNavItem">
                    <StackPanel
                        Margin="{Binding Indent}"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <PathIcon
                            Width="{x:Static types:Const.FONT_SIZE_BODY}"
                            Height="{x:Static types:Const.FONT_SIZE_BODY}"
                            VerticalAlignment="Center"
                            Data="{Binding Icon}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding LabelText}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>


        <!--  Content area: header (title + search) over the scrollable page  -->
        <Grid
            Grid.Column="1"
            RowDefinitions="Auto, *"
            Margin="28,0,0,0">

            <!--  Header  -->
            <Grid
                Grid.Row="0"
                ColumnDefinitions="*, Auto"
                Margin="0,14,14,14"
                ColumnSpacing="8">
                <TextBlock
                    x:Name="PART_Title"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="{x:Static types:Const.FONT_SIZE_TITLE}"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis" />

                <Panel Grid.Column="1">
                    <ui:PhTextBox x:Name="PART_Search" Width="260">
                        <!--  Search icon inside the textbox (left)  -->
                        <ui:PhTextBox.InnerLeftContent>
                            <PathIcon
                                Width="14"
                                Height="14"
                                Margin="8,0,2,0"
                                Data="{StaticResource IconSearch}"
                                Opacity="0.6" />
                        </ui:PhTextBox.InnerLeftContent>

                        <!--  Clear button inside the textbox (right)  -->
                        <ui:PhTextBox.InnerRightContent>
                            <Button
                                x:Name="PART_ClearSearch"
                                Margin="2,0,4,0"
                                Padding="7"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Cursor="Hand"
                                IsVisible="{Binding #PART_Search.Text, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                                <Path
                                    Width="8"
                                    Height="8"
                                    Data="{StaticResource IconClose}"
                                    Opacity="0.6"
                                    Stretch="Uniform"
                                    Stroke="{Binding $parent[Button].Foreground}"
                                    StrokeLineCap="Round"
                                    StrokeThickness="1" />
                            </Button>
                        </ui:PhTextBox.InnerRightContent>
                    </ui:PhTextBox>

                    <Popup
                        x:Name="PART_SearchPopup"
                        IsLightDismissEnabled="True"
                        Placement="BottomEdgeAlignedRight"
                        PlacementTarget="{Binding #PART_Search}">
                        <Border
                            Background="{DynamicResource MenuFlyoutPresenterBackground}"
                            BorderBrush="{DynamicResource MenuFlyoutPresenterBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource OverlayCornerRadius}">
                            <ListBox
                                x:Name="PART_SearchResults"
                                Width="400"
                                MaxHeight="350"
                                Padding="0,4"
                                Background="Transparent"
                                BorderThickness="0"
                                ClipToBounds="True"
                                CornerRadius="{DynamicResource OverlayCornerRadius}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="windows:SettingItem">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding LabelText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="{x:Static types:Const.FONT_SIZE_SMALL}"
                                                IsVisible="{Binding SectionText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                Opacity="0.6"
                                                Text="{Binding SectionText}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Panel>
            </Grid>


            <!--  Scrollable page content  -->
            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="PART_ContentHost" Padding="0,0,14,32" />
            </ScrollViewer>

        </Grid>

    </Grid>

</ui:PhControl>
