<windows:SettingsPageView
    x:Class="ImageGlass.Common.Windows.SlideshowSettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:types="using:ImageGlass.Common.Types"
    xmlns:ui="using:ImageGlass.UI"
    xmlns:windows="using:ImageGlass.Common.Windows"
    mc:Ignorable="d"
    d:DesignWidth="600"
    HorizontalAlignment="Stretch">

    <StackPanel Orientation="Vertical">

        <!--  Appearance  -->
        <ui:PhTextBlock Classes="group" LangKey="FrmSettings_Slideshow_Appearance" />
        <StackPanel Margin="{DynamicResource SettingsGroupIndent}">
            <CheckBox x:Name="PART_FullscreenSlideshow">
                <ui:PhTextBlock LangKey="FrmSettings_EnableFullscreenSlideshow" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox x:Name="PART_SlideshowCountdown">
                <ui:PhTextBlock LangKey="FrmSettings_EnableSlideshowCountdown" TextWrapping="Wrap" />
            </CheckBox>

            <!--  Slideshow Background  -->
            <StackPanel Margin="0,10,0,0" Spacing="{DynamicResource SettingsLabelInputGap}">
                <ui:PhTextBlock LangKey="FrmSettings_SlideshowBackgroundColor" />
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Button
                        x:Name="PART_BgColorButton"
                        Padding="6"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Cursor="Hand">
                        <!--  checkerboard (for alpha) underneath the selected color  -->
                        <Border
                            Width="80"
                            Height="20"
                            CornerRadius="4">
                            <Grid>
                                <Border Background="{DynamicResource ColorControlCheckeredBackgroundBrush}" CornerRadius="3" />
                                <Border x:Name="PART_BgColorSwatch" CornerRadius="3" />
                            </Grid>
                        </Border>
                    </Button>
                    <SelectableTextBlock
                        x:Name="PART_BgColorHex"
                        VerticalAlignment="Center"
                        FontFamily="{x:Static types:Const.FONT_CODE}" />
                    <ui:PhButton
                        x:Name="PART_ResetBgColor"
                        VerticalAlignment="Center"
                        IsLink="True" />
                </StackPanel>
            </StackPanel>
        </StackPanel>


        <!--  Playback  -->
        <ui:PhTextBlock Classes="group" LangKey="FrmSettings_Slideshow_Playback" />
        <StackPanel Margin="{DynamicResource SettingsGroupIndent}">
            <CheckBox x:Name="PART_LoopSlideshow">
                <ui:PhTextBlock LangKey="FrmSettings_EnableLoopSlideshow" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox x:Name="PART_RandomInterval">
                <ui:PhTextBlock LangKey="FrmSettings_EnableSlideshowRandomInterval" TextWrapping="Wrap" />
            </CheckBox>

            <!--  Interval sub-group (heading shows the live from–to range)  -->
            <TextBlock
                x:Name="PART_IntervalHeading"
                Classes="subgroup"
                TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="14">
                <StackPanel Spacing="{DynamicResource SettingsLabelInputGap}">
                    <ui:PhTextBlock x:Name="PART_IntervalFromLabel" LangKey="FrmSettings_SlideshowInterval_From" />
                    <ui:PhTextBox
                        x:Name="PART_SlideshowInterval"
                        Width="150"
                        AcceptValue="UnsignedFloatValueOnly" />
                </StackPanel>
                <StackPanel x:Name="PART_IntervalToSection" Spacing="{DynamicResource SettingsLabelInputGap}">
                    <ui:PhTextBlock LangKey="FrmSettings_SlideshowInterval_To" />
                    <ui:PhTextBox
                        x:Name="PART_SlideshowIntervalTo"
                        Width="150"
                        AcceptValue="UnsignedFloatValueOnly" />
                </StackPanel>
            </StackPanel>

            <!--  Notification sound  -->
            <StackPanel Margin="0,14,0,0" Spacing="{DynamicResource SettingsLabelInputGap}">
                <ui:PhTextBlock LangKey="FrmSettings_SlideshowImagesToNotifySound" TextWrapping="Wrap" />
                <ui:PhTextBox
                    x:Name="PART_NotifySound"
                    Width="200"
                    HorizontalAlignment="Left"
                    AcceptValue="UnsignedIntValueOnly" />
            </StackPanel>
        </StackPanel>

    </StackPanel>
</windows:SettingsPageView>
