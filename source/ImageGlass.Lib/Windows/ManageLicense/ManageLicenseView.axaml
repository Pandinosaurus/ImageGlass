<ui:PhControl
    x:Class="ImageGlass.Common.Windows.ManageLicenseView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:types="using:ImageGlass.Common.Types"
    xmlns:ui="using:ImageGlass.UI"
    mc:Ignorable="d"
    d:DesignWidth="460"
    HorizontalContentAlignment="Stretch">

    <StackPanel Orientation="Vertical">

        <!--  Header: logo + title on a 45deg accent gradient  -->
        <Border x:Name="PART_Header">
            <Border.Background>
                <LinearGradientBrush Opacity="0.3" StartPoint="0%,100%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="{DynamicResource SystemAccentColorDark3}" />
                    <GradientStop Offset="1" Color="{DynamicResource SystemAccentColorLight3}" />
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel
                Margin="24,22"
                HorizontalAlignment="Center"
                Orientation="Vertical"
                Spacing="12">
                <Image
                    x:Name="PART_Logo"
                    Width="48"
                    Height="48"
                    VerticalAlignment="Center" />
                <ui:PhTextBlock
                    x:Name="PART_LblHeading"
                    VerticalAlignment="Center"
                    FontSize="{x:Static types:Const.FONT_SIZE_TITLE}"
                    FontWeight="SemiBold" />
            </StackPanel>
        </Border>


        <!--  Upgrade mode  -->
        <StackPanel x:Name="PART_UpgradeBody" Margin="0,20,0,0">
            <ui:PhTextBlock
                x:Name="PART_LblDescription"
                MaxWidth="420"
                HorizontalAlignment="Center"
                LangKey="Menu_MnuUpgradeLicense_Description"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <!--  shown instead when a valid license does not cover this app version  -->
            <ui:PhTextBlock
                x:Name="PART_LblOutOfScope"
                MaxWidth="420"
                HorizontalAlignment="Center"
                IsVisible="False"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <!--  link to the feature comparison on the website  -->
            <ui:PhButton
                x:Name="PART_BtnCompare"
                HorizontalAlignment="Center"
                Variant="Link" />


            <Border
                Height="1"
                Margin="0,20,0,0"
                Background="{DynamicResource IG_BorderNeutralBrush}" />


            <!--  CTA buttons  -->
            <Border Padding="24,20" Background="{DynamicResource IG_BackgroundNeutralBrush}">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <ui:PhButton
                        x:Name="PART_BtnBuyOnline"
                        Width="300"
                        HorizontalContentAlignment="Stretch"
                        Variant="Accent">
                        <ui:PhTextBlock
                            Foreground="{DynamicResource AccentButtonForeground}"
                            LangKey="Menu_MnuUpgradeLicense_BuyOnline"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                    </ui:PhButton>
                    <ui:PhButton
                        x:Name="PART_BtnImportLicense"
                        Width="300"
                        HorizontalContentAlignment="Stretch">
                        <ui:PhTextBlock
                            LangKey="Menu_MnuUpgradeLicense_ImportLicense"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                    </ui:PhButton>
                    <ui:PhButton
                        x:Name="PART_BtnRetrieveEmail"
                        Width="300"
                        HorizontalContentAlignment="Stretch">
                        <ui:PhTextBlock
                            LangKey="Menu_MnuUpgradeLicense_RetrieveFromEmail"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                    </ui:PhButton>
                </StackPanel>
            </Border>
        </StackPanel>


        <!--  Manage mode  -->
        <StackPanel x:Name="PART_ManageBody" Margin="0,20,0,0">
            <Grid
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                ColumnDefinitions="Auto,*"
                HorizontalAlignment="Center">
                <ui:PhTextBlock
                    x:Name="PART_LblLicensedTo"
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,4,16,4"
                    FontWeight="SemiBold"
                    LangKey="Menu_MnuManageLicense_LicensedTo" />
                <SelectableTextBlock
                    x:Name="PART_ValLicensedTo"
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,4"
                    TextWrapping="Wrap" />

                <ui:PhTextBlock
                    x:Name="PART_LblPlan"
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,4,16,4"
                    FontWeight="SemiBold"
                    LangKey="Menu_MnuManageLicense_Plan" />
                <ui:PhButton
                    x:Name="PART_BtnPlan"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,4"
                    Variant="Link" />

                <ui:PhTextBlock
                    x:Name="PART_LblSeats"
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,4,16,4"
                    FontWeight="SemiBold"
                    LangKey="Menu_MnuManageLicense_Seats" />
                <SelectableTextBlock
                    x:Name="PART_ValSeats"
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,4"
                    TextWrapping="Wrap" />

                <ui:PhTextBlock
                    x:Name="PART_LblExpires"
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="0,4,16,4"
                    FontWeight="SemiBold"
                    LangKey="Menu_MnuManageLicense_Expires" />
                <SelectableTextBlock
                    x:Name="PART_ValExpires"
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="0,4"
                    TextWrapping="Wrap" />

                <ui:PhTextBlock
                    x:Name="PART_LblLicenseId"
                    Grid.Row="4"
                    Grid.Column="0"
                    Margin="0,4,16,4"
                    FontWeight="SemiBold"
                    LangKey="Menu_MnuManageLicense_LicenseId" />
                <SelectableTextBlock
                    x:Name="PART_ValLicenseId"
                    Grid.Row="4"
                    Grid.Column="1"
                    Margin="0,4"
                    TextWrapping="Wrap" />

                <!--  only a store build names where the license came from  -->
                <ui:PhTextBlock
                    x:Name="PART_LblSource"
                    Grid.Row="5"
                    Grid.Column="0"
                    Margin="0,4,16,4"
                    FontWeight="SemiBold"
                    LangKey="Menu_MnuManageLicense_Source" />
                <SelectableTextBlock
                    x:Name="PART_ValSource"
                    Grid.Row="5"
                    Grid.Column="1"
                    Margin="0,4"
                    TextWrapping="Wrap" />
            </Grid>



            <Border
                x:Name="PART_ManageDivider"
                Height="1"
                Margin="0,20,0,0"
                Background="{DynamicResource IG_BorderNeutralBrush}" />


            <!--  CTA buttons  -->
            <Border Padding="24,20" Background="{DynamicResource IG_BackgroundNeutralBrush}">
                <StackPanel Spacing="8">
                    <!--  Store builds only  -->
                    <ui:PhTextBlock
                        x:Name="PART_LblExportNote"
                        MaxWidth="420"
                        IsVisible="False"
                        LangKey="Menu_MnuManageLicense_ExportNote"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <!--  Store builds only  -->
                        <ui:PhButton
                            x:Name="PART_BtnExportLicense"
                            Width="300"
                            HorizontalContentAlignment="Stretch"
                            IsVisible="False">
                            <ui:PhTextBlock
                                LangKey="Menu_MnuManageLicense_ExportLicense"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                        </ui:PhButton>


                        <ui:PhButton
                            x:Name="PART_BtnChangeLicense"
                            Width="300"
                            HorizontalContentAlignment="Stretch">
                            <ui:PhTextBlock
                                LangKey="Menu_MnuManageLicense_ChangeLicense"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                        </ui:PhButton>
                        <ui:PhButton
                            x:Name="PART_BtnUpgradePlan"
                            Width="300"
                            HorizontalContentAlignment="Stretch">
                            <ui:PhTextBlock
                                LangKey="Menu_MnuManageLicense_UpgradePlan"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                        </ui:PhButton>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>


    </StackPanel>
</ui:PhControl>
