<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="RadioButton">

        <!--  ===== unchecked outer ring: match the CheckBox box (default Button face) =====  -->
        <Style Selector="^ /template/ Ellipse#OuterEllipse">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.04" />
                    <BrushTransition Property="Stroke" Duration="0:0:0.04" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:not(:checked) /template/ Ellipse#OuterEllipse">
            <Setter Property="Fill" Value="{DynamicResource PhButtonBackground}" />
            <Setter Property="Stroke" Value="{DynamicResource PhButtonBorderBrush}" />
        </Style>
        <Style Selector="^:not(:checked):pointerover /template/ Ellipse#OuterEllipse">
            <Setter Property="Fill" Value="{DynamicResource PhButtonBackgroundPointerOver}" />
            <Setter Property="Stroke" Value="{DynamicResource PhButtonBorderBrush}" />
        </Style>
        <Style Selector="^:not(:checked):pressed /template/ Ellipse#OuterEllipse">
            <Setter Property="Fill" Value="{DynamicResource PhButtonBackgroundPressed}" />
            <Setter Property="Stroke" Value="{DynamicResource PhButtonBorderBrushPressed}" />
        </Style>

        <!--  ===== checked ring: normal box background + thin 1px accent outline =====  -->
        <Style Selector="^ /template/ Ellipse#CheckOuterEllipse">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.04" />
                    <BrushTransition Property="Stroke" Duration="0:0:0.04" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:checked /template/ Ellipse#CheckOuterEllipse">
            <!--  thin 1px outline (StyleTrigger so it beats the template thickness)  -->
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Fill" Value="{DynamicResource PhButtonBackground}" />
            <Setter Property="Stroke" Value="{DynamicResource PhAccentFill}" />
        </Style>
        <Style Selector="^:checked:pointerover /template/ Ellipse#CheckOuterEllipse">
            <Setter Property="Fill" Value="{DynamicResource PhButtonBackgroundPointerOver}" />
            <Setter Property="Stroke" Value="{DynamicResource PhAccentFillPointerOver}" />
        </Style>
        <Style Selector="^:checked:pressed /template/ Ellipse#CheckOuterEllipse">
            <Setter Property="Fill" Value="{DynamicResource PhButtonBackgroundPressed}" />
            <Setter Property="Stroke" Value="{DynamicResource PhAccentFillPressed}" />
        </Style>

        <!--  ===== inner dot: bigger solid disc, same color as the checked CheckBox =====  -->
        <Style Selector="^:checked /template/ Ellipse#CheckGlyph">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Fill" Value="{DynamicResource PhAccentFill}" />
            <Setter Property="Stroke" Value="{DynamicResource PhAccentFill}" />
        </Style>
        <Style Selector="^:checked:pointerover /template/ Ellipse#CheckGlyph">
            <Setter Property="Fill" Value="{DynamicResource PhAccentFillPointerOver}" />
            <Setter Property="Stroke" Value="{DynamicResource PhAccentFillPointerOver}" />
        </Style>
        <Style Selector="^:checked:pressed /template/ Ellipse#CheckGlyph">
            <Setter Property="Fill" Value="{DynamicResource PhAccentFillPressed}" />
            <Setter Property="Stroke" Value="{DynamicResource PhAccentFillPressed}" />
        </Style>

        <!--  disabled: shared neutral palette + subtle outline, gray dot  -->
        <Style Selector="^:disabled:not(:checked) /template/ Ellipse#OuterEllipse">
            <Setter Property="Fill" Value="{DynamicResource PhControlFillDisabled}" />
            <Setter Property="Stroke" Value="{DynamicResource PhControlBorderDisabled}" />
        </Style>
        <Style Selector="^:disabled:checked /template/ Ellipse#CheckOuterEllipse">
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Fill" Value="{DynamicResource PhControlFillDisabled}" />
            <Setter Property="Stroke" Value="{DynamicResource PhControlBorderDisabled}" />
        </Style>
        <Style Selector="^:disabled:checked /template/ Ellipse#CheckGlyph">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Fill" Value="{DynamicResource PhControlGlyphDisabled}" />
            <Setter Property="Stroke" Value="{DynamicResource PhControlGlyphDisabled}" />
        </Style>

    </Style>

</Styles>
