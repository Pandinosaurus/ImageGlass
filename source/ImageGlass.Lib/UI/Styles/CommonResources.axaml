<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Shared accent fill — the single standard for every accent-filled control
        (accent Button, Slider value rail + thumb, checked CheckBox/RadioButton).
        States map directly onto the accent shade ladder produced in Core.cs
        (SystemAccentColor*), not opacity: hover steps one shade lighter, press one
        shade darker (WinUI-style), so the fill stays fully opaque in every state.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PhAccentFill" Color="{DynamicResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="PhAccentFillPointerOver" Color="{DynamicResource SystemAccentColor}" />
            <SolidColorBrush x:Key="PhAccentFillPressed" Color="{DynamicResource SystemAccentColorDark2}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PhAccentFill" Color="{DynamicResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="PhAccentFillPointerOver" Color="{DynamicResource SystemAccentColorLight3}" />
            <SolidColorBrush x:Key="PhAccentFillPressed" Color="{DynamicResource SystemAccentColorLight1}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--  Corner Radius  -->
    <CornerRadius x:Key="ControlCornerRadius">7</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

    <!--  Tooltip  -->
    <x:Double x:Key="ToolTipContentThemeFontSize">13</x:Double>
    <x:Double x:Key="ToolTipContentMaxWidth">500</x:Double>

    <!--  Text selection color  -->
    <SolidColorBrush
        x:Key="TextControlSelectionHighlightColor"
        Opacity="0.4"
        Color="{DynamicResource SystemAccentColor}" />

</ResourceDictionary>
