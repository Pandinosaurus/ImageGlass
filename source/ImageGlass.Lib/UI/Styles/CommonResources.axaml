<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PhAccentFill" Color="{DynamicResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="PhAccentFillPointerOver" Color="{DynamicResource SystemAccentColor}" />
            <SolidColorBrush x:Key="PhAccentFillPressed" Color="{DynamicResource SystemAccentColorDark2}" />

            <!--  Shared disabled palette (fill / lighter fill / gray glyph / solid borders)  -->
            <SolidColorBrush x:Key="PhControlFillDisabled" Color="#0F000000" />
            <SolidColorBrush x:Key="PhControlGlyphDisabled" Color="#66000000" />
            <SolidColorBrush x:Key="PhControlBorderDisabled" Color="#08000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PhAccentFill" Color="{DynamicResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="PhAccentFillPointerOver" Color="{DynamicResource SystemAccentColorLight3}" />
            <SolidColorBrush x:Key="PhAccentFillPressed" Color="{DynamicResource SystemAccentColorLight1}" />

            <!--  Shared disabled palette (see Light)  -->
            <SolidColorBrush x:Key="PhControlFillDisabled" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="PhControlGlyphDisabled" Color="#80FFFFFF" />
            <SolidColorBrush x:Key="PhControlBorderDisabled" Color="#11FFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--  Corner Radius  -->
    <CornerRadius x:Key="ControlCornerRadius">7</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

    <!--  Tooltip  -->
    <x:Double x:Key="ToolTipContentThemeFontSize">13</x:Double>
    <x:Double x:Key="ToolTipContentMaxWidth">500</x:Double>

    <!--  Text selection color  -->
    <x:Double x:Key="TextContentMaxWidth">600</x:Double>
    <SolidColorBrush
        x:Key="TextControlSelectionHighlightColor"
        Opacity="0.4"
        Color="{DynamicResource SystemAccentColor}" />

    <!-- Drag-drop zone outline -->
    <SolidColorBrush
        x:Key="ZoneGrayStroke"
        Opacity="0.5"
        Color="#808080" />
    <SolidColorBrush x:Key="ZoneAccentBorder" Color="{DynamicResource SystemAccentColor}" />

</ResourceDictionary>
